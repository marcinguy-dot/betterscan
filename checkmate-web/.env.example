# Database
DATABASE_URL=host=localhost user=postgres password=postgres dbname=checkmate port=5432 sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Backend
PORT=8080
# Signs the JWT bearer tokens issued by the backend. REQUIRED in production.
# Generate one with: openssl rand -hex 32
# If left empty the backend generates an ephemeral secret (tokens reset on restart).
JWT_SECRET=your-jwt-secret-key-here-change-in-production
# Comma-separated list of allowed CORS origins. Defaults to the Next.js (3000)
# and jQuery (8081) frontends when unset.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# OAuth2 - Gluu (optional)
GLUU_ISSUER=https://your-gluu-server.example.com
GLUU_CLIENT_ID=your-gluu-client-id
GLUU_CLIENT_SECRET=your-gluu-client-secret
GLUU_REDIRECT_URI=http://localhost:3000/api/auth/callback/gluu
NEXT_PUBLIC_GLUU_ENABLED=true

# Frontend
# Backend URL as reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Backend URL as reachable from the Next.js server (containers: http://backend:8080).
INTERNAL_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
# Encrypts the next-auth session cookie. REQUIRED in production.
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# Worker
CHECKMATE_PATH=../go-checkmate/checkmate-go
